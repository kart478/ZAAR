# Environment Variables for Password Reset API
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@yourapp.com

# Alternative: SendGrid Configuration
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_FROM=noreply@yourapp.com

# Alternative: Resend Configuration  
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=noreply@yourapp.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3
RATE_LIMIT_VERIFY_MAX=10

# Database Configuration (example for MongoDB)
# MONGODB_URI=mongodb://localhost:27017/yourapp
# DATABASE_URL=mongodb://localhost:27017/yourapp

# Security
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
