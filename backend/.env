# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=communitas-super-secret-jwt-key-2024
JWT_REFRESH_SECRET=communitas-super-secret-refresh-key-2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Church Connect <noreply@churchconnect.com>"
ENABLE_EMAIL=true
